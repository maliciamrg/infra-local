[Unit]
Description=Moonraker API Server
After=network-online.target klipper.service
Wants=network-online.target
Requires=klipper.service
[Service]
Type=simple
User={{ printer_user }}
SupplementaryGroups=dialout
WorkingDirectory={{ printer_home }}/moonraker
ExecStart={{ printer_home }}/moonraker-env/bin/python {{ printer_home }}/moonraker/moonraker/moonraker.py -d {{ printer_data }}
Restart=always
RestartSec=10
[Install]
WantedBy=multi-user.target
