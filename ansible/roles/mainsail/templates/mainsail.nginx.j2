server {
 listen 80 default_server;
 listen [::]:80 default_server;
 server_name _;
 root {{ mainsail_root }};
 index index.html;
 location / { try_files $uri $uri/ /index.html; }
 location /websocket {
  proxy_pass http://127.0.0.1:7125/websocket;
  proxy_http_version 1.1;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_set_header Host $host;
 }
 location /printer { proxy_pass http://127.0.0.1:7125/printer; proxy_set_header Host $host; }
 location /api { proxy_pass http://127.0.0.1:7125/api; proxy_set_header Host $host; }
 location /access { proxy_pass http://127.0.0.1:7125/access; proxy_set_header Host $host; }
 location /machine { proxy_pass http://127.0.0.1:7125/machine; proxy_set_header Host $host; }
 location /server { proxy_pass http://127.0.0.1:7125/server; proxy_set_header Host $host; }
}
